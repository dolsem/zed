    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@preact/signals": "^2.11.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
