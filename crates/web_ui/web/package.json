{
  "name": "zed-mobile-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA for controlling Zed from a phone",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
